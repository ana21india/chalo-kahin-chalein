# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Gemini — server-side only, deliberately NOT prefixed with VITE_ so it
# never gets bundled into client code. Used by api/explain-options.js
# (and the matching Vite dev middleware) to generate the AI-written
# per-option summaries shown on the Options tab.
GEMINI_API_KEY=your-gemini-api-key
